{
	"name": "tappen-frontend",
	"private": true,
	"version": "1.0.4",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"render-pass": "node scripts/render-pass.mjs",
		"dev:swish-pay": "node scripts/dev-swish-pay.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && (svelte-kit sync || echo '')",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie localStorage globalVariable baseLocale --silent",
		"check": "svelte-kit sync && pnpm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && pnpm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"api:generate:auth": "openapi-typescript http://localhost:8001/api/v0/spec.json -o src/lib/api/generated/auth.d.ts",
		"api:generate:api": "openapi-typescript http://localhost:8000/v0/spec.json -o src/lib/api/generated/api.d.ts",
		"api:generate": "pnpm run api:generate:auth && pnpm run api:generate:api",
		"ios": "pnpm build && npx cap sync ios && npx cap open ios",
		"android": "pnpm build && npx cap sync android && npx cap open android"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.2",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.13.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-confetti": "^2.3.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@capacitor-community/screen-brightness": "^8.0.0",
		"@capacitor/android": "8.2.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "8.2.0",
		"@capacitor/device": "^8.0.3",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "8.2.0",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/push-notifications": "^8.1.2",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.3",
		"@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
		"@capgo/capacitor-inappbrowser": "^8.17.2",
		"@lucide/svelte": "^1.47.0",
		"auth-lib": "link:auth-lib",
		"barcode-detector": "^3.2.2",
		"leaflet": "^1.9.4",
		"openapi-fetch": "^0.17.0",
		"qrcode-generator": "^2.0.4",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"zxing-wasm": "3.1.1"
	}
}
